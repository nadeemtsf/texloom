{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "rootDir": "frontend/protocol",
    "outDir": ".tools/protocol-emit",
    "newLine": "lf"
  },
  "include": ["frontend/protocol/**/*.ts", "web/generated/document-ipc.d.ts"]
}
