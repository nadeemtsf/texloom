{
  "name": "texloom-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run protocol:check && node --test tests/*.test.cjs tests/*.test.mjs",
    "dev": "npm run protocol:emit && node scripts/prepare-assets.mjs && vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "npm run protocol:check && node scripts/prepare-assets.mjs && vite build",
    "desktop:dev": "node scripts/prepare-native-verifier.mjs && tauri dev",
    "desktop:build": "node scripts/prepare-native-verifier.mjs && tauri build",
    "test:core": "cargo test -p texloom-core",
    "protocol:emit": "node scripts/check-protocol.mjs --write",
    "protocol:check": "node scripts/check-protocol.mjs --check",
    "protocol:rust:generate": "cargo run --locked -p texloom-desktop --features typegen --example document_bindings -- --write",
    "protocol:rust:check": "cargo run --locked -p texloom-desktop --features typegen --example document_bindings -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "monaco-editor": "^0.52.0",
    "pdfjs-dist": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "5.9.3",
    "vite": "^6.0.0"
  }
}
