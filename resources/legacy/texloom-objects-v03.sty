\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{texloom-objects}[2026/10/30 v0.3 Source-preserving visual text movement]
% Each wrapper retains its TeX layout contribution and inherited formatting.
% The marked-content tag lets the viewer bind actual glyphs to the source ID.
% Only balanced, single-page, non-hyperlinked source fragments are supported.
\newcommand{\TexloomLiteral}[1]{%
  \ifdefined\pdfextension
    \pdfextension literal page {#1}%
  \else\ifdefined\pdfliteral
    \pdfliteral page {#1}%
  \else
    \special{pdf:literal #1}%
  \fi\fi
}
\newcommand{\TexloomObject}[4]{%
  \begingroup
  \edef\TexloomDown{\strip@pt\dimexpr-#3pt\relax}%
  % Page literals close the engine's text object before changing graphics state.
  % A direct q/Q inside BT would restore a stale text matrix in some viewers.
  \ifdefined\XeTeXversion
    \special{pdf:btrans matrix 1 0 0 1 #2 \TexloomDown}%
    \special{pdf:code /Texloom_#1 BMC}%
  \else
    \TexloomLiteral{/Texloom_#1 BMC q 1 0 0 1 #2 \TexloomDown\space cm}%
  \fi
  #4%
  \ifdefined\XeTeXversion
    \special{pdf:code EMC}%
    \special{pdf:etrans}%
  \else
    \TexloomLiteral{Q EMC}%
  \fi
  \endgroup
}
\endinput
